<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F1"
    tools:context=".MainActivity">

    <include
        layout="@layout/layout_appbar"
        android:id="@+id/included_appbar" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/included_appbar">

        <Button
            android:id="@+id/button_manage_inventory"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:layout_marginBottom="24dp"
            android:text="Manage Inventory"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_3d_green"
            app:backgroundTint="@null" /> <Button
        android:id="@+id/button_initiate_sale"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:layout_marginBottom="24dp"
        android:text="Initiate Sale"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_3d_green"
        app:backgroundTint="@null" />

        <Button
            android:id="@+id/button_go_to_history"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="Go To History"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_3d_green"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>