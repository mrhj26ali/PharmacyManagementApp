<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99F0F4F1" /> <ImageView
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:src="@drawable/main_icon"
    android:alpha="0.08"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginBottom="-50dp"
    android:layout_marginEnd="-50dp" />

    <include
        layout="@layout/layout_appbar"
        android:id="@+id/included_appbar"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/included_appbar"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:id="@+id/main_logo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="32dp"
            android:src="@drawable/main_icon"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/button_manage_inventory"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:layout_marginBottom="20dp"
            android:text="Manage Inventory"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_3d_green"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/button_initiate_sale"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:layout_marginBottom="20dp"
            android:text="Initiate Sale"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_3d_green"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/button_go_to_history"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="Go To History"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_3d_green"
            app:backgroundTint="@null" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>